KEI_DATABASE_URL=sqlite:///./data/kei.db
KEI_API_TOKEN=replace-with-long-random-token
KEI_VALID_SCOPES=["salon","home"]
# Optional browser integration allowlist (JSON array). Example: ["http://localhost:3444"]
KEI_CORS_ORIGINS=[]
# Local-only escape hatch (not recommended): allow default insecure token.
KEI_ALLOW_INSECURE_DEFAULT_TOKEN=false
